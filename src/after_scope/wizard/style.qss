/* Kiosk styling: big targets, calm colors, readable at arm's length. */
QWidget {
    font-size: 15px;
}
QLabel#pageTitle {
    font-size: 26px;
    font-weight: 600;
    padding: 8px 0 16px 0;
}
QPushButton {
    padding: 10px 18px;
    border-radius: 6px;
    background: #e8eef5;
    border: 1px solid #b9c6d4;
}
QPushButton:hover {
    background: #d8e4f0;
}
QPushButton#bigYes {
    font-size: 18px;
    font-weight: 600;
    background: #d3ecd3;
    border-color: #8fbf8f;
    padding: 16px 28px;
}
QPushButton#nextButton {
    font-weight: 600;
    background: #cfe3f7;
    border-color: #7fa8d0;
}
QPushButton#rosterButton {
    font-size: 17px;
    padding: 16px 20px;
}
QPushButton#skipLink {
    background: transparent;
    border: none;
    color: #888;
    text-decoration: underline;
    font-size: 12px;
}
QLabel#errorLabel {
    color: #b03030;
    font-weight: 600;
}
QLabel#itemHelp, QLabel#solventInfo {
    color: #666;
    font-size: 13px;
    padding-left: 24px;
}
QLabel#selectedUser {
    font-size: 17px;
    font-weight: 600;
    color: #1e64b4;
    padding: 8px 0;
}
QGroupBox {
    margin-top: 12px;
    font-weight: 600;
}
